{
  "name": "barak-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Barak AgriTech Salam offering platform: working prototype",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch --no-warnings server/index.js\" \"vite client\"",
    "build": "vite build client",
    "build:static": "vite build --config client/vite.local.config.js",
    "start": "node --no-warnings server/index.js",
    "reset": "node --no-warnings -e \"import('./server/db.js').then(m=>{m.seed();console.log('reseeded')})\"",
    "test": "node --no-warnings --test test/*.test.js"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "js-sha256": "^0.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.12.0",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=22.13"
  }
}
